---
import Default from '@astrojs/starlight/components/SiteTitle.astro';
---

<div class="header-override">
  <Default {...Astro.props} />
  <nav class="custom-nav-links">
    <a href="/standards/">Core Standards</a>
    <a href="https://MARSProgramming.github.io/MARSLib/javadoc/index.html" target="_blank">API Reference</a>
  </nav>
</div>

<style>
  .header-override {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .custom-nav-links {
    display: none; /* Hide on mobile defaults */
  }
  @media (min-width: 50rem) {
    .custom-nav-links {
      display: flex;
      gap: 1.5rem;
      align-items: center;
      margin-left: 1.5rem;
      border-left: 1px solid var(--sl-color-hairline-shade);
      padding-left: 1.5rem;
      height: 2rem;
    }
    .custom-nav-links a {
      color: var(--sl-color-white);
      text-decoration: none;
      font-weight: 500;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: color 0.2s;
    }
    .custom-nav-links a:hover {
      color: var(--sl-color-accent-high);
    }
  }
</style>
