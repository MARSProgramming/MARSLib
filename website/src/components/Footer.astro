---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
---

<div class="custom-footer-wrapper">
  <!-- Render original Starlight Footer elements (Prev/Next/Edit) -->
  <DefaultFooter {...Astro.props} />
  
  <footer class="mars-mega-footer">
    <div class="footer-grid">
      <div class="footer-col">
        <h2>Docs</h2>
        <ul>
          <li><a href="/getting-started/01-setup-and-infrastructure/">Getting Started</a></li>
          <li><a href="/reference/controller-mappings/">Controller Mappings</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h2>Community</h2>
        <ul>
          <li><a href="https://www.marsfirst.org" aria-label="Visit the official MARS team website">MARS Website</a></li>
          <li><a href="https://www.firsthalloffame.org" aria-label="Learn about the FIRST Hall of Fame">Hall of Fame</a></li>
          <li><a href="https://github.com/MARSProgramming/MARSLib/discussions" aria-label="Contact the MARS team on GitHub Discussions">Contact Us</a></li>
          <li><a href="/acknowledgements/">Acknowledgements</a></li>
          <li><a href="https://www.thebluealliance.com/team/2614" aria-label="View the team stats on The Blue Alliance">TBA Profile</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h2>More</h2>
        <ul>
          <li><a href="/contributing/standards/">Core Standards</a></li>
          <li><a href="https://github.com/MARSProgramming/MARSLib" aria-label="View the MARSLib source code on GitHub">GitHub</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-values">
      <p class="footer-values-label">Built on the <i>FIRST</i>® Core Values</p>
      <div class="footer-values-list">
        <a href="/contributing/discovery/" style="color:#ef4435">Discovery</a>
        <a href="/framework-architecture/innovation/" style="color:#3498db">Innovation</a>
        <a href="/contributing/impact/" style="color:#2ecc71">Impact</a>
        <a href="/framework-architecture/teamwork-abstraction/" style="color:#e67e22">Teamwork</a>
        <a href="/contributing/accessibility/" style="color:#9b59b6">Inclusion</a>
        <a href="/framework-architecture/fun/" style="color:#f1c40f">Fun</a>
        <a href="/contributing/discomfort/" style="color:#1abc9c">Discomfort</a>
      </div>
    </div>
    <div class="footer-copyright">
      Copyright © {new Date().getFullYear()} Mountaineer Area RoboticS — FRC Team 2614. Built with Astro & Starlight.<br/>
      <a href="https://github.com/MARSProgramming/MARSLib/actions/workflows/a11y.yml" target="_blank" rel="noopener noreferrer">
        <img src="https://img.shields.io/badge/A11y-WCAG_AA-brightgreen" alt="Accessibility Standards Badge" style="margin-top: 10px; display: inline-block;"/>
      </a>
    </div>
  </footer>
</div>

<script>
  // Surgical WebAIM WAVE alert removal for Starlight's generic components
  document.addEventListener("DOMContentLoaded", () => {
    // Fix Unlabeled form control
    document.querySelectorAll('starlight-theme-select select').forEach(s => s.setAttribute('aria-label', 'Select theme'));
    // Fix Orphaned form label
    document.querySelectorAll('label.sr-only').forEach(l => {
      if(l.getAttribute('for') === 'theme-selector' && !document.getElementById('theme-selector')) {
        l.remove();
      }
    });
  });
</script>

<style>
  .custom-footer-wrapper {
    margin-top: 3rem;
  }
  .mars-mega-footer {
    background: var(--ifm-footer-background-color, #141414);
    padding: 3rem 2rem 1rem 2rem;
    border-top: 1px solid var(--sl-color-hairline, #222);
    /* Break out of Starlight content container padding to match Docusaurus full-width footer */
    margin: 3rem calc(-1 * var(--sl-content-pad-x)) 0 calc(-1 * var(--sl-content-pad-x));
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1000px;
    margin: 0 auto;
  }
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
  .footer-col h2 {
    color: var(--sl-color-white);
    font-size: 1.1rem;
    margin-bottom: 1rem;
    font-weight: bold;
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-col li {
    margin-bottom: 0.5rem;
  }
  .footer-col a {
    color: var(--sl-color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-col a:hover {
    color: var(--sl-color-accent-high);
  }
  .footer-values {
    text-align: center;
    margin-top: 2.5rem;
  }
  .footer-values-label {
    color: var(--sl-color-text-muted);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .footer-values-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 14px;
  }
  .footer-values-list span {
    font-weight: 600;
    font-size: 0.85rem;
  }
  .footer-values-list a {
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .footer-values-list a:hover {
    opacity: 0.7;
    text-decoration: underline;
  }
  .footer-copyright {
    text-align: center;
    color: var(--sl-color-text-muted);
    margin-top: 1.5rem;
    font-size: 0.9rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 1rem;
  }
</style>
