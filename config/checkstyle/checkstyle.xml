<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java, properties, xml"/>

    <module name="TreeWalker">
        <!-- MARSLib Rule: No Hungarian Notation (No 'm_' prefix) -->
        <module name="MemberName">
            <property name="format" value="^(?!m_)[a-z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern"
             value="Member name ''{0}'' must not use Hungarian notation (m_ prefix) per MARSLib core standards."/>
        </module>

        <!-- Method params should also not use Hungarian notation -->
        <module name="ParameterName">
            <property name="format" value="^(?!m_|_)[a-z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern"
             value="Parameter name ''{0}'' must not use Hungarian notation."/>
        </module>

        <!-- Local variables -->
        <module name="LocalVariableName">
            <property name="format" value="^(?!m_|_)[a-z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern"
             value="Local variable name ''{0}'' must not use Hungarian notation."/>
        </module>
    </module>
</module>
